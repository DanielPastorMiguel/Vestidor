/* ---------- Tokens ---------- */
:root {
  --bg: #0B0B0D;
  --bg-elevated: #17171A;
  --card: #1B1B1F;
  --card-hi: #232327;
  --border: #2A2A2F;
  --text: #F3EFEA;
  --text-dim: #9A9A9F;
  --text-faint: #6C6C72;
  --red: #E4283A;
  --red-hi: #FF3F52;
  --red-dim: #7A1620;
  --red-bg: rgba(228, 40, 58, 0.12);
  --ok: #3CC17A;
  --font-display: 'Bebas Neue', 'Inter', system-ui, sans-serif;
  --font-body: 'Inter', system-ui, -apple-system, sans-serif;
  --radius: 14px;
  --radius-sm: 9px;
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
}

* { box-sizing: border-box; }
html, body { height: 100%; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  -webkit-tap-highlight-color: transparent;
  overscroll-behavior-y: none;
}
button { font-family: inherit; }
:focus-visible { outline: 2px solid var(--red-hi); outline-offset: 2px; }

#app { min-height: 100%; display: flex; flex-direction: column; }

/* ---------- Topbar ---------- */
#topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(var(--safe-top) + 14px) 16px 14px;
  position: sticky;
  top: 0;
  z-index: 20;
  background: linear-gradient(to bottom, var(--bg) 80%, transparent);
}
#topbar-title {
  font-family: var(--font-display);
  font-size: 26px;
  letter-spacing: 4px;
  color: var(--text);
}
.icon-btn {
  background: none;
  border: none;
  color: var(--text);
  padding: 6px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-btn:active { background: var(--card); }
.icon-btn-spacer { width: 34px; display: inline-block; }

#view {
  flex: 1;
  padding: 4px 16px calc(var(--safe-bottom) + 24px);
  max-width: 560px;
  width: 100%;
  margin: 0 auto;
}

/* ---------- Buttons ---------- */
.btn {
  border: none;
  border-radius: var(--radius-sm);
  padding: 14px 18px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.btn-primary { background: var(--red); color: #fff; }
.btn-primary:active { background: var(--red-dim); }
.btn-outline {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--border);
}
.btn-outline:active { background: var(--card); }
.btn-ghost {
  background: var(--card);
  color: var(--text);
  border: 1px solid var(--border);
}
.btn-block { width: 100%; }
.btn-danger { background: transparent; color: var(--red-hi); border: 1px solid var(--red-dim); }
.btn:disabled { opacity: 0.45; }

/* ---------- Date nav ---------- */
.date-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  margin: 6px 0 18px;
}
.date-nav button.arrow {
  background: var(--card);
  border: 1px solid var(--border);
  color: var(--text);
  width: 40px;
  height: 40px;
  border-radius: 50%;
  font-size: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.date-nav button.arrow:active { background: var(--card-hi); }
.date-label {
  background: none;
  border: none;
  color: var(--text);
  text-align: center;
  min-width: 180px;
}
.date-label .d1 { font-family: var(--font-display); font-size: 22px; letter-spacing: 1px; display:block; }
.date-label .d2 { font-size: 12px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; }

/* ---------- Home: choice buttons ---------- */
.choice-row { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }
.choice-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 22px;
  text-align: left;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 14px;
}
.choice-card:active { background: var(--card-hi); }
.choice-card .emoji { font-size: 26px; }
.choice-card .title { font-weight: 700; font-size: 16px; }
.choice-card .sub { font-size: 12.5px; color: var(--text-dim); margin-top: 2px; }
.choice-card.primary { border-color: var(--red-dim); background: var(--red-bg); }

/* ---------- Outfit grid ---------- */
.outfit-grid { display: flex; flex-direction: column; gap: 10px; }
.outfit-row {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 10px;
  min-height: 96px;
}
.outfit-row .thumb {
  width: 76px;
  height: 76px;
  border-radius: var(--radius-sm);
  background: var(--bg-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.outfit-row .thumb img { width: 100%; height: 100%; object-fit: contain; }
.outfit-row .meta { flex: 1; min-width: 0; }
.outfit-row .cat-label { font-size: 10.5px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--red-hi); font-weight: 700; }
.outfit-row .titulo { font-weight: 600; font-size: 15px; margin-top: 2px; }
.outfit-row .colores { font-size: 12.5px; color: var(--text-dim); margin-top: 2px; }
.outfit-row.empty { justify-content: center; color: var(--text-faint); font-size: 13px; }

.swatch { display:inline-block; width: 10px; height: 10px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.15); vertical-align: middle; margin-right:4px;}

/* ---------- Personas ---------- */
.personas-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
.persona-chip {
  background: var(--card);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 13px;
}
.persona-chip.removable { display:flex; align-items:center; gap:6px; }
.persona-chip .x { color: var(--text-faint); cursor:pointer; }

.section-label { font-size: 11.5px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-dim); margin: 22px 0 8px; }

/* ---------- Edit outfit area ---------- */
#edit-outfit-options { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }

/* ---------- Calendar ---------- */
.cal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.cal-month { font-family: var(--font-display); font-size: 22px; letter-spacing: 2px; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
.cal-dow { text-align: center; font-size: 10.5px; color: var(--text-faint); text-transform: uppercase; padding-bottom: 6px; }
.cal-day {
  aspect-ratio: 1/1;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  position: relative;
  color: var(--text);
  font-size: 13px;
  padding: 4px 2px;
}
.cal-day.other-month { opacity: 0.28; }
.cal-day.today { border-color: var(--red-hi); }
.cal-day.selected { background: var(--red-bg); border-color: var(--red); }
.cal-day .bars { display: flex; flex-direction: column; gap: 2px; width: 70%; margin-top: 2px; }
.cal-day .bar { height: 3px; border-radius: 2px; display: flex; overflow: hidden; }
.cal-day .bar span { height: 100%; }

/* ---------- Forms ---------- */
.field { margin-bottom: 16px; }
.field label { display: block; font-size: 12.5px; color: var(--text-dim); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
.field input[type="text"],
.field input[type="number"],
.field input[type="password"],
.field select,
.field textarea {
  width: 100%;
  background: var(--card);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 12px 14px;
  border-radius: var(--radius-sm);
  font-size: 15px;
}
.field textarea { resize: vertical; min-height: 70px; }
.field-row { display: flex; gap: 10px; }
.field-row .field { flex: 1; }

.chip-select { display: flex; flex-wrap: wrap; gap: 8px; }
.chip-select button {
  background: var(--card);
  border: 1px solid var(--border);
  color: var(--text-dim);
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 13px;
}
.chip-select button.active { background: var(--red); color: #fff; border-color: var(--red); font-weight: 600; }

/* ---------- Screen scaffolding ---------- */
.screen-header { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.back-btn { background: none; border: none; color: var(--text-dim); font-size: 22px; padding: 4px 8px 4px 0; }
.screen-title { font-family: var(--font-display); font-size: 24px; letter-spacing: 1.5px; }
.screen-sub { color: var(--text-dim); font-size: 13px; margin: -4px 0 18px; }

/* ---------- Garment picker grid ---------- */
.garment-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.garment-card {
  background: var(--card);
  border: 2px solid var(--border);
  border-radius: var(--radius-sm);
  overflow: hidden;
  text-align: left;
  color: var(--text);
  padding: 0;
}
.garment-card.selected { border-color: var(--red); }
.garment-card .thumb { width: 100%; aspect-ratio: 1/1; background: var(--bg-elevated); display:flex; align-items:center; justify-content:center; overflow:hidden; }
.garment-card .thumb img { width: 100%; height: 100%; object-fit: contain; }
.garment-card .cap { padding: 6px 8px 8px; font-size: 11.5px; }
.garment-card .cap .t { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.garment-card .cap .c { color: var(--text-dim); }
.garment-empty { grid-column: 1/-1; text-align:center; color: var(--text-faint); padding: 30px 0; font-size: 13px; }

.search-bar { display: flex; align-items: center; gap: 8px; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 10px 14px; margin-bottom: 12px; }
.search-bar input { flex: 1; background: none; border: none; color: var(--text); font-size: 14px; }
.search-bar input:focus { outline: none; }

/* ---------- Drawer ---------- */
.drawer { position: fixed; inset: 0; z-index: 50; }
.drawer.hidden { display: none; }
.drawer-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.55); }
.drawer-panel {
  position: absolute; top: 0; left: 0; bottom: 0;
  width: min(86vw, 380px);
  background: var(--bg);
  border-right: 1px solid var(--border);
  display: flex; flex-direction: column;
  padding-top: var(--safe-top);
  overflow-y: auto;
  animation: slideIn 0.18s ease-out;
}
@keyframes slideIn { from { transform: translateX(-16px); opacity:0; } to { transform: translateX(0); opacity:1; } }
.drawer-header { display:flex; align-items:center; justify-content: space-between; padding: 16px; border-bottom: 1px solid var(--border); }
.drawer-title { font-family: var(--font-display); font-size: 20px; letter-spacing: 2px; }
#drawer-content { padding: 16px; }

.settings-item {
  width: 100%;
  background: var(--card);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 14px 16px;
  border-radius: var(--radius-sm);
  text-align: left;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  font-size: 14.5px;
  font-weight: 600;
}
.settings-item .arrow { color: var(--text-faint); }

/* ---------- Modal ---------- */
.modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 60; display: flex; align-items: flex-end; }
.modal-sheet {
  background: var(--bg);
  border-top: 1px solid var(--border);
  border-radius: 20px 20px 0 0;
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 18px 18px calc(var(--safe-bottom) + 18px);
  animation: slideUp 0.18s ease-out;
}
@keyframes slideUp { from { transform: translateY(24px); opacity:0;} to { transform: translateY(0); opacity:1;} }
.modal-sheet .sheet-handle { width: 40px; height: 4px; background: var(--border); border-radius: 4px; margin: 0 auto 14px; }

/* ---------- Multi-select persona list ---------- */
.persona-pick-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 4px; border-bottom: 1px solid var(--border);
}
.persona-pick-row .name { font-size: 14.5px; }
.checkbox {
  width: 22px; height: 22px; border-radius: 6px; border: 1px solid var(--border);
  display:flex; align-items:center; justify-content:center; color: transparent;
}
.checkbox.checked { background: var(--red); border-color: var(--red); color: #fff; }

/* ---------- Toast ---------- */
#toast-root { position: fixed; left: 0; right: 0; bottom: calc(var(--safe-bottom) + 18px); display: flex; justify-content: center; z-index: 80; pointer-events: none; }
.toast {
  background: var(--card-hi);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 12px 18px;
  border-radius: 999px;
  font-size: 13.5px;
  max-width: 88vw;
  box-shadow: 0 8px 24px rgba(0,0,0,0.4);
}
.toast.error { border-color: var(--red-dim); color: #FFD5D9; }

/* ---------- Misc ---------- */
.hidden { display: none !important; }
.empty-state { text-align: center; padding: 50px 10px; color: var(--text-faint); }
.empty-state .icon { font-size: 34px; margin-bottom: 10px; }
.spinner {
  width: 20px; height: 20px; border-radius: 50%;
  border: 2.5px solid rgba(255,255,255,0.25); border-top-color: #fff;
  animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-block { display:flex; flex-direction:column; align-items:center; gap: 14px; padding: 60px 0; color: var(--text-dim); font-size: 13.5px;}

.reasoning-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-left: 3px solid var(--red);
  border-radius: var(--radius-sm);
  padding: 14px 16px;
  font-size: 13.5px;
  color: var(--text-dim);
  margin: 16px 0;
}

.action-row { display: flex; gap: 10px; margin-top: 18px; }
.action-row .btn { flex: 1; }

.detail-photo { width: 100%; aspect-ratio: 1/1; background: var(--bg-elevated); border-radius: var(--radius); display:flex; align-items:center; justify-content:center; overflow:hidden; margin-bottom: 16px;}
.detail-photo img { width: 100%; height: 100%; object-fit: contain; }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; margin-bottom: 20px; }
.detail-grid .k { font-size: 11px; color: var(--text-faint); text-transform: uppercase; letter-spacing: .5px; }
.detail-grid .v { font-size: 14px; margin-top: 2px; }

@media (min-width: 640px) {
  .choice-row { flex-direction: row; }
  .choice-card { flex: 1; }
}

/* ---------- Toggle switch ---------- */
.switch-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 4px 0; }
.switch-row .switch-label { font-size: 14px; }
.switch-row .switch-sub { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
.switch { position: relative; display: inline-block; width: 46px; height: 27px; flex-shrink: 0; }
.switch input { opacity: 0; width: 0; height: 0; position: absolute; }
.switch .track { position: absolute; inset: 0; background: var(--border); border-radius: 999px; transition: background 0.15s; }
.switch input:checked + .track { background: var(--red); }
.switch .thumb { position: absolute; top: 3px; left: 3px; width: 21px; height: 21px; background: #fff; border-radius: 50%; transition: transform 0.15s; }
.switch input:checked + .track .thumb { transform: translateX(19px); }

/* ---------- Eyedropper (pincel de color) ---------- */
.eyedropper-wrap { position: relative; width: 100%; border-radius: var(--radius-sm); overflow: hidden; background: var(--bg-elevated); }
.eyedropper-wrap img { width: 100%; display: block; cursor: crosshair; touch-action: none; }
.eyedropper-marker {
  position: absolute; width: 20px; height: 20px; border: 2px solid #fff; border-radius: 50%;
  box-shadow: 0 0 0 2px rgba(0,0,0,0.5); transform: translate(-50%, -50%); pointer-events: none;
}
.eyedropper-hint { font-size: 12.5px; color: var(--text-dim); margin: 8px 0 4px; text-align: center; }
.eyedropper-preview { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
.eyedropper-preview .swatch-big { width: 30px; height: 30px; border-radius: 8px; border: 1px solid var(--border); }

/* ---------- Home: fotos grandes del outfit ---------- */
.photo-stack { display: flex; flex-direction: column; gap: 10px; }
.photo-tile {
  width: 100%;
  aspect-ratio: 1/1;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  padding: 0;
}
.photo-tile img { width: 100%; height: 100%; object-fit: contain; background: var(--bg-elevated); }
.photo-tile.empty { display: flex; align-items: center; justify-content: center; color: var(--text-faint); font-size: 13px; border-style: dashed; }

/* ---------- Spinner overlay sobre una foto ---------- */
.photo-processing { position: relative; }
.photo-processing::after {
  content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.45);
}
.processing-overlay {
  position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 8px; color: #fff; font-size: 12.5px; z-index: 2;
}

